<!DOCTYPE html>
<html>
<head>
<title>Tugas 4 - JavaScript</title>
</head>
<body>

<!-- HEADER: Nama, NIM, Foto -->
<table>
  <tr>
    <td><img src="https://i.pinimg.com/736x/19/bd/bb/19bdbbf96d1cd75f883aef7bd9707724.jpg" width="80" height="80" alt="Foto"></td>
    <td>
      Nama : Annabel Putri<br>
      NIM  : 255314046
    </td>
  </tr>
</table>
<hr>

<!-- KOTAK UTAMA -->
<div id="kotak" style="border:1px solid black; padding:10px; width:400px;">
  Nama : <input type="text" id="nama"><br><br>
  Jumlah Pilihan : <input type="number" id="jumlah" min="1" max="10" value="1">
  <button id="ok1">OK</button>

  <div id="bagian2"></div>
  <div id="bagian3"></div>
  <div id="bagian4"></div>
</div>

<p id="hasil"></p>

<script>
// ubah menjadi "dropdown" untuk tampilan Drop Down
var bentuk = "radio";

var nama = "";
var jumlah = 0;
var pilihan = [];      // array teks pilihan
var terpilih = "";
var email = "";

// membuat elemen sederhana
function buat(tag, isi) {
  var e = document.createElement(tag);
  if (isi) e.textContent = isi;
  return e;
}

// ---------- OK 1 : nama & jumlah ----------
function ok1() {
  nama = document.getElementById("nama").value.trim();
  jumlah = Number(document.getElementById("jumlah").value);

  if (nama == "") {
    alert("Nama harus diisi!");
    return;
  }
  if (!Number.isInteger(jumlah) || jumlah < 1 || jumlah > 10) {
    alert("Jumlah pilihan harus bilangan bulat 1 - 10!");
    return;
  }

  // kosongkan bagian berikutnya
  document.getElementById("bagian3").innerHTML = "";
  document.getElementById("bagian4").innerHTML = "";
  var b2 = document.getElementById("bagian2");
  b2.innerHTML = "";
  b2.appendChild(buat("br"));

  // loop membuat input Teks Pilihan
  for (var i = 1; i <= jumlah; i++) {
    b2.appendChild(document.createTextNode("Pilihan " + i + " : "));
    var inp = buat("input");
    inp.type = "text";
    inp.id = "teks" + i;
    b2.appendChild(inp);
    b2.appendChild(buat("br"));
  }

  var tombol = buat("button", "OK");
  tombol.onclick = ok2;
  b2.appendChild(tombol);
}

// ---------- OK 2 : simpan teks ke array, buat pilihan ----------
function ok2() {
  pilihan = [];
  for (var i = 1; i <= jumlah; i++) {
    var teks = document.getElementById("teks" + i).value.trim();
    if (teks == "") {
      alert("Pilihan " + i + " harus diisi!");
      return;
    }
    pilihan.push(teks);
  }

  document.getElementById("bagian4").innerHTML = "";
  var b3 = document.getElementById("bagian3");
  b3.innerHTML = "";
  b3.appendChild(buat("br"));
  b3.appendChild(document.createTextNode("Pilihan : "));

  if (bentuk == "radio") {
    // loop membuat Radio Button
    for (var i = 0; i < pilihan.length; i++) {
      var r = buat("input");
      r.type = "radio";
      r.name = "pil";
      r.value = pilihan[i];
      if (i == 0) r.checked = true;
      b3.appendChild(r);
      b3.appendChild(document.createTextNode(pilihan[i] + " "));
      b3.appendChild(buat("br"));
    }
  } else {
    // loop membuat Drop Down
    var s = buat("select");
    s.id = "dd";
    for (var j = 0; j < pilihan.length; j++) {
      var o = buat("option", pilihan[j]);
      o.value = pilihan[j];
      s.appendChild(o);
    }
    b3.appendChild(s);
    b3.appendChild(buat("br"));
  }

  var tombol = buat("button", "OK");
  tombol.onclick = ok3;
  b3.appendChild(tombol);
}

// ---------- OK 3 : ambil pilihan, buat input email ----------
function ok3() {
  if (bentuk == "radio") {
    terpilih = document.querySelector('input[name="pil"]:checked').value;
  } else {
    terpilih = document.getElementById("dd").value;
  }

  var b4 = document.getElementById("bagian4");
  b4.innerHTML = "";
  b4.appendChild(buat("br"));
  b4.appendChild(document.createTextNode("Email : "));

  var inp = buat("input");
  inp.type = "text";
  inp.id = "email";
  b4.appendChild(inp);

  var tombol = buat("button", "OK");
  tombol.onclick = ok4;
  b4.appendChild(tombol);
}

// ---------- OK 4 : cek email, tampilkan hasil ----------
function ok4() {
  var kolom = document.getElementById("email");
  var pola = /^[A-Za-z0-9._-]+@[A-Za-z0-9-]+(\.[A-Za-z]{2,})+$/;

  if (!pola.test(kolom.value.trim())) {
    alert("Format email salah! Contoh: nama@domain.com\nSilakan masukkan ulang.");
    kolom.value = "";
    kolom.focus();
    return;
  }
  email = kolom.value.trim();

  // sembunyikan kotak, tampilkan hasil
  document.getElementById("kotak").style.display = "none";
  document.getElementById("hasil").textContent =
    "Hallo, nama saya " + nama + ", email " + email +
    " saya mempunyai sejumlah " + jumlah + " pilihan yaitu " +
    pilihan.join(", ") + ", dan saya memilih " + terpilih;
}

// event tombol OK pertama
document.getElementById("ok1").onclick = ok1;
</script>

</body>
</html>